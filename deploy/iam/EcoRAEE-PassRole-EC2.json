{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PasarSoloElRolDeLaApi",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::CUENTA:role/EcoRAEE-EC2-AppRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "VerRolesYPerfiles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoles",
        "iam:ListInstanceProfiles",
        "iam:GetInstanceProfile"
      ],
      "Resource": "*"
    }
  ]
}
