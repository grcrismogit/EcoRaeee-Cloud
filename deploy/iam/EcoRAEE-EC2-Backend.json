{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvidenciasObjetos",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_EVIDENCIAS/evidencias/*"
    },
    {
      "Sid": "EvidenciasListar",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_EVIDENCIAS"
    },
    {
      "Sid": "PublicarEventosRAEE",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:CUENTA:ecoraee-eventos"
    },
    {
      "Sid": "LeerConfiguracion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:CUENTA:parameter/ecoraee",
        "arn:aws:ssm:us-east-1:CUENTA:parameter/ecoraee/*"
      ]
    }
  ]
}
