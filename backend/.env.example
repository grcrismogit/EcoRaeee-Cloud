# Copie este archivo como .env (en la carpeta backend) solo si cambió los datos de conexión.
DATABASE_URL=postgresql+psycopg://ecoraee:ecoraee_local@localhost:5432/ecoraee
JWT_SECRET=cambia-esta-clave
CORS_ORIGINS=http://localhost:5173

# --- Solo en AWS (en EC2 los carga deploy/ec2/iniciar_api.sh desde SSM Parameter Store) ---
# S3_BUCKET_EVIDENCIAS=ecoraee-evidencias-xxxx   # sin esta variable las evidencias van a backend/storage
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ecoraee-eventos
# AWS_REGION=us-east-1
# Nunca ponga AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY aquí: en EC2 se usa el rol IAM de la instancia.
